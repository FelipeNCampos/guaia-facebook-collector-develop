SUFFIX=dev
FB_ENV_FILE=.env.dev
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8080
ALLOWED_HOSTS=*
API_PORT_EXTERNAL=8094
DB_HOST=db
DB_PORT=5432
DB_PUBLISHED_PORT=5485
DB_NAME=app
DB_USER=app
DB_PASSWORD=app
# Opcional: se definido, sobrescreve DB_HOST/DB_PORT/DB_NAME na conexão.
# DB_DSN=postgresql://app:app@db:<DB_PORT>/app
AMQP_URL=amqp://guest:guest@rabbitmq:5672/
AMQP_PORT_EXTERNAL=5684
RABBITMQ_MANAGEMENT_PORT_EXTERNAL=15684
USER_REQUESTS_QUEUE=user_requests
GOOGLE_RUNNER_QUEUE=user_requests
GOOGLE_RUNNER_HEADLESS=true
GOOGLE_RUNNER_MAX_PAGES=10
GOOGLE_RUNNER_PAGE_LOAD_TIMEOUT=20
GOOGLE_RUNNER_WAIT_TIMEOUT=15
GOOGLE_RUNNER_SERVICE_HTTP_PORT=8091
GOOGLE_RUNNER_PORT_EXTERNAL=8095
GOOGLE_CHROME_PROFILE_DIRECTORY=
# Obrigatoria para subir o ambiente via docker compose.
GOOGLE_2CAPTCHA_API_KEY=
MESSAGE_RETRY_MAX_ATTEMPTS=3
MESSAGE_RETRY_BASE_DELAY_MS=30000
SERVICE_HTTP_HOST=0.0.0.0
SERVICE_HTTP_PORT=8090
# Base defaults for the shared facebook_runner image.
# Each service in deploy/docker-compose.yml overrides queue/type with one of:
# facebook.perfil, facebook.video, facebook.reel, facebook.post,
# facebook.storie, facebook.foto, facebook.permalink
FACEBOOK_RUNNER_QUEUE=facebook.perfil
FACEBOOK_RUNNER_TYPE=perfil
FACEBOOK_RUNNER_HEADLESS=true
FACEBOOK_RUNNER_PAGE_LOAD_TIMEOUT=20
FACEBOOK_RUNNER_WAIT_TIMEOUT=15
FACEBOOK_CHROME_PROFILE_DIRECTORY=
FACEBOOK_RUNNER_PREFETCH_COUNT=1
FACEBOOK_EXTRACTOR_CONCURRENCY_LIMIT=2
FACEBOOK_EXTRACTOR_SLOT_WAIT_SECONDS=120
FACEBOOK_RESULT_LIMIT=200
FACEBOOK_RUNNER_SERVICE_HTTP_PORT=8101
FACEBOOK_DOWNLOAD_MEDIA=false
FACEBOOK_MEDIA_DOWNLOAD_TIMEOUT_SECONDS=60
FACEBOOK_MEDIA_MAX_BYTES=262144000
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=
FACEBOOK_API_BASE_URL=http://api:8080
GUAIA_CONFIG_PATH=/workspace/feeder/config.yml
FACEBOOK_FEEDER_QUERY_SOURCE=5
FACEBOOK_FEEDER_SOURCE_TYPE=3
FACEBOOK_FEEDER_TARGET_TYPES=1,5
FACEBOOK_FEEDER_POLL_INTERVAL=30
FACEBOOK_FEEDER_WAIT_TIMEOUT_SECONDS=3600
FACEBOOK_FEEDER_WAIT_POLL_SECONDS=20
FACEBOOK_FEEDER_REQUEST_RETRY_LIMIT=3
FACEBOOK_FEEDER_HTTP_TIMEOUT_SECONDS=15
REGISTRY_IMAGE=registry.gitlab.com/fakenews-tre-go/guaia-facebook-collector
IMAGE_TAG=dev
LOG_LEVEL=INFO
